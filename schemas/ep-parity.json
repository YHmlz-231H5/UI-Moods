        "file-list",
        "filtered-value",
        "filters",
        "fixed-data",
        "headers",
        "left-default-checked",
        "marks",
        "options",
        "page-sizes",
        "predefine",
        "preview-src-list",
        "props",
        "right-default-checked",
        "shortcuts",
        "sort-state",
        "table",
        "target-order",
        "texts",
        "url-list"
      ]
    },
    "component": {
      "why": "a component to put in a slot — this library draws its own shapes in CSS and has no component to place",
      "props": [
        "active-action-icon",
        "active-icon",
        "clear-icon",
        "close-icon",
        "collapse-close-icon",
        "collapse-open-icon",
        "disabled-void-icon",
        "ellipsis-icon",
