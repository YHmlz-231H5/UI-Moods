        "badge-style",
        "body-class",
        "body-style",
        "cell-class-name",
        "cell-style",
        "class",
        "class-name",
        "collapse-class",
        "collapse-style",
        "custom-class",
        "filter-class-name",
        "footer-class",
        "header-cell-class-name",
        "header-cell-style",
        "header-class",
        "header-row-class-name",
        "header-row-style",
        "hue-slider-class",
        "hue-slider-style",
        "input-style",
        "label-class-name",
        "modal-class",
        "popper-class",
        "popper-style",
        "prefix-cls",
        "row-class",
        "row-class-name",
        "row-style",
        "style",
        "tooltip-class",
        "view-class",
        "view-style",
        "wrap-class",
        "wrap-style"
      ]
    }
  },
  "components": {
    "affix": { "ep": ["el-affix"] },
    "alert": { "ep": ["el-alert"], "equiv": { "type": "variant" } },
    "anchor": { "ep": ["el-anchor", "el-anchor-link"] },
    "autocomplete": { "ep": ["el-autocomplete"] },
    "avatar": {
      "ep": ["el-avatar", "el-avatar-group"],
      "equiv": { "shape": "variant `circle` or `square`" }
    },
    "backtop": { "ep": ["el-backtop"] },
    "badge": { "ep": ["el-badge"], "equiv": { "type": "variant" } },
    "border": { "ep": [] },
    "breadcrumb": { "ep": ["el-breadcrumb", "el-breadcrumb-item"] },
    "button": {
      "ep": ["el-button", "el-button-group"],
      "rename": { "type": "variant" },
      "equiv": {
        "plain": "variant `default` is the outline button",
        "text": "variant `text` is the ghost button"
      }
    },
    "calendar": { "ep": ["el-calendar"] },
    "card": { "ep": ["el-card"] },
    "carousel": { "ep": ["el-carousel", "el-carousel-item"] },
    "cascader": { "ep": ["el-cascader"] },
    "checkbox": { "ep": ["el-checkbox", "el-checkbox-button"] },
    "checkbox-group": { "ep": ["el-checkbox-group"] },
    "collapse": { "ep": ["el-collapse", "el-collapse-item"] },
    "color": { "ep": [] },
    "color-picker": { "ep": ["el-color-picker"] },
    "color-picker-panel": { "ep": ["el-color-picker-panel"] },
    "config-provider": { "ep": ["el-config-provider"] },
    "container": { "ep": ["el-container", "el-header", "el-aside", "el-main", "el-footer"] },
    "date-picker": { "ep": ["el-date-picker"] },
    "date-picker-panel": { "ep": ["el-date-picker-panel"] },
    "date-time-picker": { "ep": ["el-date-picker"] },
    "descriptions": { "ep": ["el-descriptions", "el-descriptions-item"] },
    "dialog": { "ep": ["el-dialog"] },
    "divider": {
      "ep": ["el-divider"],
      "equiv": { "direction": "variant `vertical`" }
    },
    "drawer": { "ep": ["el-drawer"] },
    "dropdown": { "ep": ["el-dropdown", "el-dropdown-menu", "el-dropdown-item"] },
    "empty": { "ep": ["el-empty"] },
    "field": { "ep": ["el-form", "el-form-item"] },
    "icon": { "ep": ["el-icon"] },
    "image": { "ep": ["el-image", "el-image-viewer"] },
    "infinite-scroll": { "ep": [] },
    "input": { "ep": ["el-input", "el-select", "el-option", "el-option-group"] },
    "input-number": { "ep": ["el-input-number"] },
    "input-otp": { "ep": ["el-input-otp"] },
    "input-tag": { "ep": ["el-input-tag"] },
    "layout": { "ep": ["el-row", "el-col"] },
    "link": { "ep": ["el-link"], "equiv": { "type": "variant" } },
    "loading": {
      "ep": ["loading"],
      "ignore": ["parent", "svg", "svg-view-box", "spinner", "visible"]
    },
    "menu": { "ep": ["el-menu", "el-sub-menu", "el-menu-item", "el-menu-item-group"] },
    "mention": { "ep": ["el-mention"] },
    "message": { "ep": ["message"], "equiv": { "type": "variant" } },
    "message-box": { "ep": ["message-box"] },
    "notification": { "ep": ["notification"], "equiv": { "type": "variant" } },
    "page-header": { "ep": ["el-page-header"] },
    "pagination": { "ep": ["el-pagination"] },
    "popconfirm": { "ep": ["el-popconfirm"] },
    "popover": { "ep": ["el-popover"] },
    "progress": { "ep": ["el-progress"], "equiv": { "type": "variant" } },
    "radio": { "ep": ["el-radio", "el-radio-button"] },
    "radio-group": { "ep": ["el-radio-group"] },
    "rate": { "ep": ["el-rate"] },
    "result": { "ep": ["el-result"], "equiv": { "type": "variant" } },
    "scrollbar": { "ep": ["el-scrollbar"] },
    "segmented": { "ep": ["el-segmented"] },
    "skeleton": { "ep": ["el-skeleton", "el-skeleton-item"], "equiv": { "type": "variant" } },
    "slider": { "ep": ["el-slider"] },
    "space": { "ep": ["el-space"] },
    "splitter": { "ep": ["el-splitter", "el-splitter-panel"] },
    "statistic": { "ep": ["el-statistic", "el-countdown"], "equiv": { "type": "variant" } },
    "steps": { "ep": ["el-steps", "el-step"] },
    "switch": { "ep": ["el-switch"] },
