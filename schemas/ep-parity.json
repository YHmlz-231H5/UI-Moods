        "back",
        "cancel",
        "closeAutoFocus",
        "closed",
        "collapse",
        "confirm",
        "destroy",
        "drop",
        "edit",
        "error",
        "expandChange",
        "file",
        "finish",
        "load",
        "openAutoFocus",
        "opened",
        "pick",
        "remove",
        "removeTag",
        "resize",
        "resizeEnd",
        "resizeStart",
        "rotate",
        "show",
        "switch",
        "tabAdd",
        "tabChange",
        "tabClick",
        "tabRemove",
        "validate",
        "visibleChange"
