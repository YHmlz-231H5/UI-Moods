    "tabs": { "ep": ["el-tabs", "el-tab-pane"] },
    "tag": { "ep": ["el-tag", "el-check-tag"], "equiv": { "type": "variant" } },
    "text": { "ep": ["el-text"] },
    "time-picker": { "ep": ["el-time-picker"] },
    "time-select": { "ep": ["el-time-select"] },
    "timeline": { "ep": ["el-timeline", "el-timeline-item"], "equiv": { "type": "variant" } },
    "tooltip": { "ep": ["el-tooltip"] },
    "tour": { "ep": ["el-tour", "el-tour-step"] },
    "transfer": { "ep": ["el-transfer"] },
    "tree": { "ep": ["el-tree"] },
