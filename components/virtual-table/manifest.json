{
  "id": "virtual-table",
  "name": "Virtualized Table",
  "nameZh": "虚拟表格",
  "category": "data",
  "element": "div",
  "summary": "A long table the browser is not asked to lay out in full. The rows far from the viewport are skipped and given a placeholder size, so the cost of the list is what is near it.",
  "summaryZh": "一张很长的表,浏览器不用把每一行都排一遍。离视口远的那些行会被跳过,先占一个位置大小,所以这张表的代价只有离视口近的那部分。",
  "since": "1.1.0",
  "style": "style.css",
  "class": {"base":"um-virtual-table","modifier":"um-virtual-table--","part":"um-virtual-table__"},
  "variants": [
    {"id":"bordered","name":"Bordered","nameZh":"带边框","state":"outline","note":"A frame around the scrolling box and a line between the columns, so a table with many columns can be read down one of them."},
    {"id":"plain","name":"Plain","nameZh":"无边框","state":"ghost","note":"The base class on its own is this, and the modifier paints the same thing so the class list can name it."}
  ],
  "sizes": [
    {"id":"sm","name":"Small","nameZh":"小","note":"The rows take the caption size, so more of them fit in the same height."},
    {"id":"md","name":"Medium","nameZh":"中","default":true,"note":"The default size. The base class is already this size, so it needs no modifier."},
    {"id":"lg","name":"Large","nameZh":"大","note":"The rows take the title size."}
  ],
  "states": [
    {"id":"focus-visible","name":"Focus visible","nameZh":"键盘聚焦","selector":":focus-visible","native":true,"note":"The ring goes on the scrolling box, inside the frame: an outside ring would be cut off by the frame that holds it."},
    {"id":"scrollbar-always-on","name":"Scrollbar always on","nameZh":"常驻滚动条","selector":".um-virtual-table--scrollbar-always-on","note":"The scrolling box keeps its scrollbar whether the list needs one or not, so the rows do not move sideways as the list grows."},
    {"id":"fixed","name":"Fixed first column","nameZh":"固定首列","selector":".um-virtual-table--fixed","note":"The first column stays where it is while the rest of the row scrolls sideways. It brings its own surface, so the cells that scroll under it do not show through it."}
  ],
  "parts": [
    {"id":"scroller","name":"Scroller","nameZh":"滚动区","note":"The box that scrolls. It carries the overflow and the surface, and the host gives it a height, because a box that is not given one never scrolls."},
    {"id":"header","name":"Header","nameZh":"表头","note":"The row of column names. It is sticky, so it stays where it is while the body scrolls under it."},
    {"id":"head-cell","name":"Head cell","nameZh":"表头单元格","note":"One column name. It is a columnheader, so the name travels with the cells below it."},
    {"id":"body","name":"Body","nameZh":"表体","note":"The rows. It is a rowgroup, so a screen reader reads them as one block."},
    {"id":"row","name":"Row","nameZh":"行","note":"One record. It carries the skip: the browser does not lay out a row that is far from the viewport."},
    {"id":"cell","name":"Cell","nameZh":"单元格","note":"One value. It is a gridcell, so the column name is announced with it."},
    {"id":"empty","name":"Empty","nameZh":"空状态","note":"The cell that says there is nothing. It spans the whole row."},
    {"id":"footer","name":"Footer","nameZh":"表尾","note":"What stands under the table: the totals, a note. It takes no room when the host has nothing to put in it."},
    {"id":"overlay","name":"Overlay","nameZh":"浮层","note":"What lies over the table: a mask, a loading bar. It takes no room when the host has nothing to put in it."}
  ],
  "props": [
    {"name":"variant","type":"enum","values":["bordered","plain"],"default":"plain","description":"Which surface the table is drawn on. The plain run is the base class on its own; the bordered run adds a rule around it.","descriptionZh":"表格画在哪种表面上。无边框就是只写基类;带边框再加上 um-virtual-table--bordered。"},
    {"name":"size","type":"enum","values":["sm","md","lg"],"default":"md","description":"How tall a row is and how big the type in it is.","descriptionZh":"行有多高,里面的字有多大。"},
    {"name":"rows","type":"number","default":"200","description":"How many rows the list has. The wrapper writes one row per record, and the stylesheet skips the ones the reader cannot see.","descriptionZh":"这份清单有多少行。包装器一条记录写一行,样式表跳过读者看不见的那些行。"},
    {"name":"columns","type":"string","default":"Node, Build, State","description":"The column names, separated by commas.","descriptionZh":"列名,用逗号分开。"},
    {"name":"height","type":"string","default":"16em","description":"How tall the scrolling box is. The library cannot guess it: a box that is not given a height never scrolls, because its content is what gives it one.","descriptionZh":"滚动区有多高。库猜不出来:没给高度的盒子不会滚,因为给它高度的是它自己的内容。"},
    {"name":"empty","type":"boolean","default":"false","description":"That there is nothing to show. The body says so instead of writing the rows.","descriptionZh":"表示没有内容可显示。表体就说这件事,而不是把那些行写出来。"},
    {"name":"scrollbar-always-on","type":"boolean","default":"false","since":"1.1.0","description":"Whether the scrolling box keeps its scrollbar whether the list needs one or not, so the rows do not move sideways as the list grows. It adds um-virtual-table--scrollbar-always-on.","descriptionZh":"滚动区是否一直留着滚动条,不管这份清单用不用得上,这样清单变长时行不会横向挪动。它加上 um-virtual-table--scrollbar-always-on。"},
    {"name":"fixed","type":"boolean","default":"false","since":"1.1.0","description":"Whether the first column stays where it is while the rest of the row scrolls sideways. The cell brings its own surface, so the cells that scroll under it do not show through it. It adds um-virtual-table--fixed.","descriptionZh":"第一列是否固定在原处,其余的列横向滚动。这一格带着自己的底色,所以从它下面滚过去的格子不会透出来。它加上 um-virtual-table--fixed。"}
  ],
  "slots": [
    {"name":"header","description":"What stands in the row of column names. It is given the column names.","descriptionZh":"列名那一行里放什么。它拿到的是列名本身。"},
    {"name":"header-cell","description":"What one column name says. It is given the name and the column it is in.","descriptionZh":"某一个列名写什么。它拿到这个名字和它所在的列。"},
    {"name":"row","description":"What one record holds. It is given the number of the row. Without it the row is written cell by cell.","descriptionZh":"一条记录里放什么。它拿到这一行的序号。不给就一格一格地写出来。"},
    {"name":"cell","description":"What one value says. It is given the row, the column and the value the wrapper would have written.","descriptionZh":"某一个值写什么。它拿到行号、列号,以及包装器本来会写出来的那个值。"},
    {"name":"empty","description":"What the empty state says when there is nothing to show.","descriptionZh":"没有内容可显示时,空状态说什么。"},
    {"name":"footer","description":"What stands under the table: the totals, a note.","descriptionZh":"表格底下放什么:合计,或者一句说明。"},
    {"name":"overlay","description":"What lies over the table: a mask, a loading bar.","descriptionZh":"盖在表格上的是什么:一层遮罩,或者一条加载条。"}
  ],
  "events": [],
  "a11y": {
    "role": "grid",
    "keyboard": [
      "Tab",
      "Arrow keys",
      "Page Up",
      "Page Down",
      "Home",
      "End"
    ],
    "notes": "The table is an ARIA grid of divs: role=\"grid\" on the scrolling box, role=\"row\" on each row and role=\"gridcell\" on each cell, so a screen reader reads a row across and announces the column name with every cell — the same thing a real table does. It is a grid of divs rather than a real <table> for a measured reason: Chrome will not skip the layout of a table row, because a row is sized by its table, so content-visibility: auto on a <tr> changed nothing at all in a 200-row table, and on the <td>s it broke the row heights. The scrolling box is a real element with overflow on it and a tabindex, so it can be reached with Tab and scrolled with the arrow keys, the page keys and Home and End — the browser's own scrolling, not a script.",
    "notesZh": "这张表是用 div 拼出来的 ARIA 网格:滚动区上是 role=\"grid\",每一行是 role=\"row\",每一格是 role=\"gridcell\",所以读屏还是横着读一行,并且每个格子都带着列名一起播报 —— 和真表格一样。之所以不用真表格是量出来的:Chrome 不会跳过表格行的排版,因为行的大小由表格决定,所以在 <tr> 上写 content-visibility: auto 在一张 200 行的表里什么也没改变,写在 <td> 上则把行高弄坏了。滚动区是一个带 overflow、带 tabindex 的真元素,所以 Tab 能走到它,方向键、翻页键和 Home、End 都能滚它 —— 这是浏览器自己的滚动,不是脚本画的。"
  },
  "examples": [
    {
      "id": "table",
      "title": "A virtualized table",
      "titleZh": "一张虚拟表格",
      "description": "Forty-eight rows in a box that is shorter than they are. The header stays where it is while the body scrolls, and the rows the reader cannot see are not laid out: the browser gives them a placeholder size instead, and lays them out when they come near.",
      "descriptionZh": "四十八行放在一个比它们矮的盒子里。表头待在原处,表体在下面滚;读者看不见的那些行没有排版,浏览器先给它们一个位置大小,等它们靠近了再排。",
      "markup": "<div class=\"um-virtual-table um-virtual-table--plain\">\n  <div class=\"um-virtual-table__scroller\" role=\"grid\" aria-label=\"Builds\" aria-rowcount=\"48\" aria-colcount=\"3\" tabindex=\"0\" style=\"height: 16em;\">\n    <div class=\"um-virtual-table__header\" role=\"row\">\n      <span class=\"um-virtual-table__head-cell\" role=\"columnheader\">Node</span>\n      <span class=\"um-virtual-table__head-cell\" role=\"columnheader\">Build</span>\n      <span class=\"um-virtual-table__head-cell\" role=\"columnheader\">State</span>\n    </div>\n    <div class=\"um-virtual-table__body\" role=\"rowgroup\">\n      <div class=\"um-virtual-table__row\" role=\"row\">\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">node-01</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">210</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">passing</span>\n      </div>\n      <div class=\"um-virtual-table__row\" role=\"row\">\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">node-02</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">211</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">passing</span>\n      </div>\n      <div class=\"um-virtual-table__row\" role=\"row\">\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">node-03</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">212</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">passing</span>\n      </div>\n      <div class=\"um-virtual-table__row\" role=\"row\">\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">node-04</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">213</span>\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">failed</span>\n      </div>\n      <div class=\"um-virtual-table__row\" role=\"row\">\n        <span class=\"um-virtual-table__cell\" role=\"gridcell\">node-05