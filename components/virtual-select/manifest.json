{
  "id": "virtual-select",
  "name": "Virtual Select",
  "nameZh": "虚拟列表选择器",
  "category": "form",
  "element": "div",
  "summary": "A long list of choices that the browser only lays out near the viewport. The rows far away are skipped, and the browser is told how tall such a row is, so the scrollbar is right without every row being built.",
  "summaryZh": "一长串选项,浏览器只把靠近视口的那几行真的排出来。远处的行被跳过,浏览器同时被告知这种行有多高,所以滚动条是对的,却不用把每一行都建出来。",
  "since": "1.1.0",
  "style": "style.css",
  "class": {
    "base": "um-virtual-select",
    "modifier": "um-virtual-select--",
    "part": "um-virtual-select__"
  },
  "variants": [
    {
      "id": "bordered",
      "name": "Bordered",
      "nameZh": "描边",
      "state": "outline",
      "note": "The list has a frame and sits on the overlay surface. The base class on its own is this, and the modifier paints the same thing so the class list can name it."
    },
    {
      "id": "plain",
      "name": "Plain",
      "nameZh": "无边框",
      "state": "ghost",
      "note": "The list drops its frame and its fill, so it sits straight on the page."
    }
  ],
  "sizes": [
    {
      "id": "sm",
      "name": "Small",
      "nameZh": "小",
      "note": "The rows take the small control height, and the placeholder size follows it, so the scrollbar is right at this size too."
    },
    {
      "id": "md",
      "name": "Medium",
      "nameZh": "中",
      "default": true,
      "note": "The default list. The base class is already this size, so it needs no modifier."
    },
    {
      "id": "lg",
      "name": "Large",
      "nameZh": "大",
      "note": "The rows take the large control height, and the placeholder size follows it."
    }
  ],
  "states": [
    {
      "id": "checked",
      "name": "Checked",
      "nameZh": "选中",
      "selector": ":checked",
      "native": true,
      "note": "The chosen row takes the brand's barely-there tint, and the words on it take the foreground the contract writes for that tint."
    },
    {
      "id": "focus-visible",
      "name": "Focus visible",
      "nameZh": "键盘聚焦",
      "selector": ":focus-visible",
      "native": true,
      "note": "The ring goes inside the row, the way the ring on a button in a row goes inside it: an outside ring would be cut off by the scroller."
    }
  ],
  "parts": [
    {
      "id": "scroller",
      "name": "Scroller",
      "nameZh": "滚动区",
      "note": "The bounded box the list scrolls in. How much of a long list fits on a page is the host's business, so its height is the host's."
    },
    {
      "id": "list",
      "name": "List",
      "nameZh": "列表",
      "note": "The listbox. It holds the rows."
    },
    {
      "id": "option",
      "name": "Option",
      "nameZh": "选项",
      "note": "One row. It is the row the browser skips when it is far away, so it carries the row's own size with it."
    },
    {
      "id": "label",
      "name": "Label",
      "nameZh": "选项标签",
      "note": "The label around the radio. Clicking the row picks its option. It clips what it holds: a row the browser has not laid out yet is only as wide as the placeholder it stands in for, and the words must not run past the box that holds them."
    },
    {
      "id": "text",
      "name": "Text",
      "nameZh": "文字",
      "note": "The words of the option. A long name is cut with an ellipsis rather than wrapped, so every row keeps one height — which is what the placeholder size of a row the browser has not laid out yet has to match."
    }
  ],
  "props": [
    {
      "name": "value",
      "type": "string",
      "default": "Aardvark",
      "description": "The label of the option that is chosen. It is the radio's own value, so the choice is the browser's and not the library's.",
      "descriptionZh": "被选中的那个选项,写成它的名字。它是单选按钮自己的值,所以这个选择是浏览器做的,不是库做的。"
    },
    {
      "name": "options",
      "type": "string",
      "default": "Aardvark,Albatross,Badger,Barracuda,Beetle,Bison,Butterfly,Capybara,Caribou,Chameleon,Cheetah,Chinchilla",
      "description": "The labels in the list, separated by commas. The wrapper draws one option per label; the markup writes the options out.",
      "descriptionZh": "列表里的那些名字,用逗号分开。包装组件按每个名字画一个选项;标记里是把选项一个个写下来的。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "default": "Choose a species",
      "description": "The text that names the list and stands in for a choice. It is the accessible name of the listbox, so the browser announces it when the reader reaches the list. The library has no field to write a selection into, so the placeholder is what the list is called.",
      "descriptionZh": "给这个列表起名字、也代替一次选择的那段文字。它是列表框的可访问名称,所以读屏走到这个列表时会播报它。库里没有可以写进选择值的字段,所以由这个占位文字来给列表命名。"
    },
    {
      "name": "height",
      "type": "string",
      "default": "12em",
      "description": "The height of the scroller. It is a length and not a number of pixels: how tall the window onto the list is belongs to the host's page.",
      "descriptionZh": "滚动区的高度。它是一个长度,不是多少像素:这个列表开多大一个窗口,是宿主页面的事。"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "change",
      "description": "Fires when an option is picked. It is the browser's own event on the radio — the library installs no listener.",
      "descriptionZh": "选中一个选项时触发。这是单选按钮上的浏览器原生事件 —— 库没有安装任何监听器。"
    }
  ],
  "a11y": {
    "role": "listbox",
    "keyboard": [
      "Tab",
      "Arrow keys",
      "Space"
    ],
    "notes": "The list is a listbox and the rows are options, so the browser says what the list holds and which row is current. Underneath that, every option is a real radio inside a label, so the choice is in the tab order, the arrow keys move between the choices and the browser announces the picked one; the radio is kept out of sight with the same technique the switch uses, so it is still a control the keyboard can reach. Each radio names itself, because a row is a label and a label carries no text of its own.",
    "notesZh": "列表是列表框,每一行是选项,所以浏览器会说明这个列表装的是什么、当前是哪一行。在这一层底下,每个选项都是包在一个 label 里的真单选按钮,所以这个选择在 Tab 顺序里,方向键可以在选项之间走,浏览器也会播报选中的那一个;那个单选按钮是用开关组件的同一套办法藏起来的,所以它仍然是一个键盘够得到的控件。每个单选按钮都自带名字,因为一行是一个标签,标签自己不带文字。"
  },
  "examples": [
    {
      "id": "long-list",
      "title": "A long list",
      "titleZh": "一长串选项",
      "description": "Seventy rows in a box twelve em tall. The browser lays out the rows near the viewport and skips the rest, and the placeholder size tells it how tall a skipped row is, so the scrollbar is the right length even though most of the list has never been painted.",
      "descriptionZh": "七十行,放在一个十二 em 高的盒子里。浏览器只排视口附近的那些行,其余的跳过;那个占位尺寸告诉浏览器跳过的行有多高,所以哪怕大部分列表从来没有被画出来,滚动条的长度也是对的。",
      "markup": "<div class=\"um-virtual-select um-virtual-select--bordered\" style=\"--um-virtual-select-height: 12em\">\n  <div class=\"um-virtual-select__scroller\">\n    <div class=\"um-virtual-select__list\" role=\"listbox\" aria-label=\"Species\">\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"aardvark\" aria-label=\"Aardvark\" checked />\n            <span class=\"um-virtual-select__text\">Aardvark</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"albatross\" aria-label=\"Albatross\" />\n            <span class=\"um-virtual-select__text\">Albatross</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"badger\" aria-label=\"Badger\" />\n            <span class=\"um-virtual-select__text\">Badger</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"barracuda\" aria-label=\"Barracuda\" />\n            <span class=\"um-virtual-select__text\">Barracuda</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"beetle\" aria-label=\"Beetle\" />\n            <span class=\"um-virtual-select__text\">Beetle</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"bison\" aria-label=\"Bison\" />\n            <span class=\"um-virtual-select__text\">Bison</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"butterfly\" aria-label=\"Butterfly\" />\n            <span class=\"um-virtual-select__text\">Butterfly</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"capybara\" aria-label=\"Capybara\" />\n            <span class=\"um-virtual-select__text\">Capybara</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"caribou\" aria-label=\"Caribou\" />\n            <span class=\"um-virtual-select__text\">Caribou</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"chameleon\" aria-label=\"Chameleon\" />\n            <span class=\"um-virtual-select__text\">Chameleon</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"cheetah\" aria-label=\"Cheetah\" />\n            <span class=\"um-virtual-select__text\">Cheetah</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"chinchilla\" aria-label=\"Chinchilla\" />\n            <span class=\"um-virtual-select__text\">Chinchilla</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"cormorant\" aria-label=\"Cormorant\" />\n            <span class=\"um-virtual-select__text\">Cormorant</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"coyote\" aria-label=\"Coyote\" />\n            <span class=\"um-virtual-select__text\">Coyote</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"crane\" aria-label=\"Crane\" />\n            <span class=\"um-virtual-select__text\">Crane</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"dolphin\" aria-label=\"Dolphin\" />\n            <span class=\"um-virtual-select__text\">Dolphin</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"dormouse\" aria-label=\"Dormouse\" />\n            <span class=\"um-virtual-select__text\">Dormouse</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"dragonfly\" aria-label=\"Dragonfly\" />\n            <span class=\"um-virtual-select__text\">Dragonfly</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"eagle\" aria-label=\"Eagle\" />\n            <span class=\"um-virtual-select__text\">Eagle</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"egret\" aria-label=\"Egret\" />\n            <span class=\"um-virtual-select__text\">Egret</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"falcon\" aria-label=\"Falcon\" />\n            <span class=\"um-virtual-select__text\">Falcon</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"ferret\" aria-label=\"Ferret\" />\n            <span class=\"um-virtual-select__text\">Ferret</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"firefly\" aria-label=\"Firefly\" />\n            <span class=\"um-virtual-select__text\">Firefly</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"flamingo\" aria-label=\"Flamingo\" />\n            <span class=\"um-virtual-select__text\">Flamingo</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"fox\" aria-label=\"Fox\" />\n            <span class=\"um-virtual-select__text\">Fox</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"gazelle\" aria-label=\"Gazelle\" />\n            <span class=\"um-virtual-select__text\">Gazelle</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"gecko\" aria-label=\"Gecko\" />\n            <span class=\"um-virtual-select__text\">Gecko</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"giraffe\" aria-label=\"Giraffe\" />\n            <span class=\"um-virtual-select__text\">Giraffe</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"gopher\" aria-label=\"Gopher\" />\n            <span class=\"um-virtual-select__text\">Gopher</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"grouse\" aria-label=\"Grouse\" />\n            <span class=\"um-virtual-select__text\">Grouse</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"hedgehog\" aria-label=\"Hedgehog\" />\n            <span class=\"um-virtual-select__text\">Hedgehog</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"heron\" aria-label=\"Heron\" />\n            <span class=\"um-virtual-select__text\">Heron</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"ibex\" aria-label=\"Ibex\" />\n            <span class=\"um-virtual-select__text\">Ibex</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"ibis\" aria-label=\"Ibis\" />\n            <span class=\"um-virtual-select__text\">Ibis</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"jackal\" aria-label=\"Jackal\" />\n            <span class=\"um-virtual-select__text\">Jackal</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"jaguar\" aria-label=\"Jaguar\" />\n            <span class=\"um-virtual-select__text\">Jaguar</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"kestrel\" aria-label=\"Kestrel\" />\n            <span class=\"um-virtual-select__text\">Kestrel</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"kingfisher\" aria-label=\"Kingfisher\" />\n            <span class=\"um-virtual-select__text\">Kingfisher</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"kite\" aria-label=\"Kite\" />\n            <span class=\"um-virtual-select__text\">Kite</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"koala\" aria-label=\"Koala\" />\n            <span class=\"um-virtual-select__text\">Koala</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"lemur\" aria-label=\"Lemur\" />\n            <span class=\"um-virtual-select__text\">Lemur</span>\n          </label>\n        </div>\n        <div class=\"um-virtual-select__option\" role=\"option\">\n          <label class=\"um-virtual-select__label\">\n            <input type=\"radio\" name=\"um-virtual-select\" value=\"lynx\" aria-label=\"L