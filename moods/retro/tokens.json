{
  "id": "retro",
  "version": "1.0.0",
  "meta": {
    "name": "Retro",
    "nameZh": "复古",
    "appearance": "light",
    "surfaceFamily": "paper-70s",
    "keywords": [
      "seventies",
      "paper",
      "warm",
      "chunky"
    ],
    "fonts": {
      "preferred": [
        "Georgia",
        "Songti SC"
      ],
      "fallbacks": [
        "serif"
      ]
    }
  },
  "colors": {
    "bg": "#f4e4c1",
    "panel": "#fbf3e2",
    "surface": "#ffffff",
    "text": "#3d3128",
    "textStrong": "#2b211a",
    "muted": "#8a7a6a",
    "border": "#b39b7a",
    "accent": "#d2691e",
    "onAccent": "#fff8ec",
    "ok": "#6b8e23",
    "warn": "#daa520",
    "danger": "#a0522d"
  },
  "typography": {
    "family": "Georgia, Songti SC, serif",
    "displaySize": "42px",
    "titleSize": "17px",
    "bodySize": "15px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 700
    }
  },
  "radii": {
    "block": "8px",
    "button": "6px",
    "card": "10px",
    "badge": "999px",
    "input": "6px"
  },
  "borders": {
    "width": "2px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "4px 4px 0 0 #3d3128",
    "button": "3px 3px 0 0 #3d3128"
  },
  "spacing": {
    "section": "30px",
    "block": "18px",
    "gap": "14px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
