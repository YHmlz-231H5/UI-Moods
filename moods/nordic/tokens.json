{
  "id": "nordic",
  "version": "1.0.0",
  "meta": {
    "name": "Nordic",
    "nameZh": "北欧",
    "appearance": "light",
    "surfaceFamily": "scandi-quiet",
    "keywords": [
      "scandinavian",
      "muted",
      "functional",
      "airy"
    ],
    "fonts": {
      "preferred": [
        "Inter",
        "Helvetica Neue"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f7f7f5",
    "panel": "#ffffff",
    "surface": "#f1f1ee",
    "text": "#3a3a38",
    "textStrong": "#161614",
    "muted": "#8a8a86",
    "border": "#e2e2dd",
    "accent": "#2f5d50",
    "onAccent": "#ffffff",
    "ok": "#4f7a52",
    "warn": "#b4874a",
    "danger": "#a4503f"
  },
  "typography": {
    "family": "Inter, Helvetica Neue, system-ui, sans-serif",
    "displaySize": "36px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "4px",
    "button": "4px",
    "card": "8px",
    "badge": "999px",
    "input": "4px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "0 2px 8px rgba(22,22,20,0.06)",
    "button": "0 1px 2px rgba(22,22,20,0.08)"
  },
  "spacing": {
    "section": "32px",
    "block": "20px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
