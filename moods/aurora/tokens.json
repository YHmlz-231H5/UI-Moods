{
  "id": "aurora",
  "version": "1.0.0",
  "meta": {
    "name": "Aurora",
    "nameZh": "极光",
    "appearance": "dark",
    "surfaceFamily": "northern-lights",
    "keywords": [
      "aurora",
      "gradient",
      "teal-violet",
      "deep"
    ],
    "fonts": {
      "preferred": [
        "Outfit",
        "Inter"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#06111c",
    "panel": "rgba(255,255,255,0.05)",
    "surface": "rgba(120,220,255,0.10)",
    "text": "#d6e8f2",
    "textStrong": "#ffffff",
    "muted": "#7f9fb0",
    "border": "rgba(255,255,255,0.14)",
    "accent": "#5eead4",
    "onAccent": "#04202a",
    "ok": "#4ade80",
    "warn": "#fcd34d",
    "danger": "#fb7185"
  },
  "typography": {
    "family": "Outfit, Inter, system-ui, sans-serif",
    "displaySize": "42px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "12px",
    "button": "10px",
    "card": "18px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(14px)",
    "panelOpacity": 0.05,
    "glow": "0 0 30px rgba(94,234,212,0.4)"
  },
  "shadows": {
    "card": "0 14px 44px rgba(0,20,40,0.6)",
    "button": "0 0 16px rgba(94,234,212,0.3)"
  },
  "spacing": {
    "section": "30px",
    "block": "20px",
    "gap": "14px"
  },
  "motion": {
    "duration": "0.4s",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
