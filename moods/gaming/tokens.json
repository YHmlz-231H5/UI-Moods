{
  "id": "gaming",
  "version": "1.0.0",
  "meta": {
    "name": "Gaming",
    "nameZh": "电竞",
    "appearance": "dark",
    "surfaceFamily": "hud-neon",
    "keywords": [
      "gaming",
      "hud",
      "angular",
      "cyan-on-black"
    ],
    "fonts": {
      "preferred": [
        "Rajdhani",
        "Chakra Petch"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#0d0d12",
    "panel": "#15151f",
    "surface": "#1c1c2a",
    "text": "#b8b8d0",
    "textStrong": "#ffffff",
    "muted": "#6f6f8f",
    "border": "#2a2a3e",
    "accent": "#00e5ff",
    "onAccent": "#04121a",
    "ok": "#39ff14",
    "warn": "#ffb020",
    "danger": "#ff3b6b"
  },
  "typography": {
    "family": "Rajdhani, Chakra Petch, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "4px",
    "button": "4px",
    "card": "6px",
    "badge": "2px",
    "input": "4px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(8px)",
    "panelOpacity": 0.9,
    "glow": "0 0 20px rgba(0,229,255,0.45)"
  },
  "shadows": {
    "card": "0 6px 24px rgba(0,0,0,0.6)",
    "button": "0 0 14px rgba(0,229,255,0.35)"
  },
  "spacing": {
    "section": "28px",
    "block": "16px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "steps(3, end)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
