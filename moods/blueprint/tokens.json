{
  "id": "blueprint",
  "version": "1.0.0",
  "meta": {
    "name": "Blueprint",
    "nameZh": "蓝图",
    "appearance": "dark",
    "surfaceFamily": "drafting-blue",
    "keywords": [
      "blueprint",
      "drafting",
      "uppercase",
      "technical",
      "blueprint-paper"
    ],
    "fonts": {
      "preferred": [
        "Barlow Condensed"
      ],
      "fallbacks": [
        "Space Grotesk",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#0b3d6e",
    "panel": "#0a3560",
    "surface": "#0c447a",
    "text": "#c8dcf0",
    "textStrong": "#eef6ff",
    "muted": "#7aa0c0",
    "border": "rgba(160,200,255,0.35)",
    "accent": "#ffffff",
    "onAccent": "#0a3560",
    "ok": "#7dffb0",
    "warn": "#ffd56a",
    "danger": "#ff8a8a"
  },
  "typography": {
    "family": "Barlow Condensed, 'Space Grotesk', sans-serif",
    "displaySize": "44px",
    "titleSize": "16px",
    "bodySize": "15px",
    "labelSize": "10px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "0",
    "button": "0",
    "card": "0",
    "badge": "0",
    "input": "0"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "0 0 0 1px rgba(160,200,255,0.18)",
    "button": "none"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "border": "{colors.border}"
    }
  }
}
