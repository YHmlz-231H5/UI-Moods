{
  "id": "night",
  "version": "1.0.0",
  "meta": {
    "name": "Night",
    "nameZh": "夜航",
    "appearance": "dark",
    "surfaceFamily": "glowing-glass",
    "keywords": [
      "night",
      "blue",
      "glow",
      "monospace",
      "dark"
    ],
    "fonts": {
      "preferred": [
        "IBM Plex Mono"
      ],
      "fallbacks": [
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "colors": {
    "bg": "#05070c",
    "panel": "rgba(10,16,28,0.92)",
    "surface": "rgba(12,20,36,0.7)",
    "text": "#9eb4d0",
    "textStrong": "#e8f0ff",
    "muted": "#6a8098",
    "border": "rgba(70,120,180,0.3)",
    "accent": "#5ec8ff",
    "onAccent": "#061018",
    "ok": "#5ef0c8",
    "warn": "#f0c060",
    "danger": "#ff8a9a",
    "onAccentSolid": "#05070c",
    "onOkSolid": "#05070c",
    "onWarnSolid": "#05070c",
    "onDangerSolid": "#05070c"
  },
  "typography": {
    "family": "IBM Plex Mono, ui-monospace, monospace",
    "displaySize": "34px",
    "titleSize": "14px",
    "bodySize": "12px",
    "labelSize": "10px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "8px",
    "button": "4px",
    "card": "8px",
    "badge": "4px",
    "input": "6px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "glow": "0 0 24px rgba(60,160,255,0.18)"
  },
  "shadows": {
    "card": "inset 0 1px 0 rgba(120,180,255,0.08)",
    "button": "0 0 12px rgba(60,160,255,0.08)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}"
    },
    "badge": {
      "neutral": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.border}",
        "radius": "{radii.badge}"
      },
      "accent": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccentSolid}",
        "border": "{colors.accent}",
        "radius": "{radii.badge}"
      },
      "ok": {
        "bg": "{colors.ok}",
        "fg": "{colors.onOkSolid}",
        "border": "{colors.ok}",
        "radius": "{radii.badge}"
      },
      "warn": {
        "bg": "{colors.warn}",
        "fg": "{colors.onWarnSolid}",
        "border": "{colors.warn}",
        "radius": "{radii.badge}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onDangerSolid}",
        "border": "{colors.danger}",
        "radius": "{radii.badge}"
      }
    },
    "alert": {
      "neutral": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.border}"
      },
      "accent": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.accent}"
      },
      "ok": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.ok}"
      },
      "warn": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.warn}"
      },
      "danger": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.danger}"
      }
    }
  }
}
