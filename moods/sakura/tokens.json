{
  "id": "sakura",
  "version": "1.0.0",
  "meta": {
    "name": "Sakura",
    "nameZh": "樱见",
    "appearance": "light",
    "surfaceFamily": "soft-petal",
    "keywords": [
      "sakura",
      "japanese",
      "petal",
      "gentle"
    ],
    "fonts": {
      "preferred": [
        "Hiragino Sans",
        "PingFang SC"
      ],
      "fallbacks": [
        "Microsoft YaHei",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#fdf5f7",
    "panel": "#ffffff",
    "surface": "#fbe9ee",
    "text": "#5b4750",
    "textStrong": "#38262e",
    "muted": "#a2858f",
    "border": "#f0d8e0",
    "accent": "#e0607e",
    "onAccent": "#ffffff",
    "ok": "#7fa87f",
    "warn": "#d9a441",
    "danger": "#c0392b"
  },
  "typography": {
    "family": "Hiragino Sans, PingFang SC, Microsoft YaHei, sans-serif",
    "displaySize": "38px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "12px",
    "button": "999px",
    "card": "16px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(10px)",
    "panelOpacity": 0.92,
    "glow": "none"
  },
  "shadows": {
    "card": "0 8px 28px rgba(224,96,126,0.14)",
    "button": "0 3px 10px rgba(224,96,126,0.16)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "ease-out"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
