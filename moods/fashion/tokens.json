{
  "id": "fashion",
  "version": "1.0.0",
  "meta": {
    "name": "Fashion",
    "nameZh": "时装",
    "appearance": "light",
    "surfaceFamily": "editorial-monochrome",
    "keywords": [
      "fashion",
      "editorial",
      "didot",
      "asymmetric"
    ],
    "fonts": {
      "preferred": [
        "Didot",
        "Bodoni MT"
      ],
      "fallbacks": [
        "Georgia",
        "serif"
      ]
    }
  },
  "colors": {
    "bg": "#ffffff",
    "panel": "#ffffff",
    "surface": "#f6f6f6",
    "text": "#111111",
    "textStrong": "#000000",
    "muted": "#767676",
    "border": "#e5e5e5",
    "accent": "#1a1a1a",
    "onAccent": "#ffffff",
    "ok": "#4f7942",
    "warn": "#b3874a",
    "danger": "#9b2c2c"
  },
  "typography": {
    "family": "Didot, Bodoni MT, Georgia, serif",
    "displaySize": "52px",
    "titleSize": "18px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 700
    }
  },
  "radii": {
    "block": "0px",
    "button": "0px",
    "card": "0px",
    "badge": "999px",
    "input": "0px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "none",
    "button": "none"
  },
  "spacing": {
    "section": "44px",
    "block": "24px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.4s",
    "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
