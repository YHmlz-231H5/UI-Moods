{
  "id": "luxury",
  "version": "1.0.0",
  "meta": {
    "name": "Luxury",
    "nameZh": "奢雅",
    "appearance": "light",
    "surfaceFamily": "editorial",
    "keywords": [
      "luxury",
      "editorial",
      "serif",
      "hairline",
      "minimal"
    ],
    "fonts": {
      "preferred": [
        "Cormorant Garamond"
      ],
      "fallbacks": [
        "Georgia",
        "serif"
      ]
    }
  },
  "colors": {
    "bg": "#f6f4f0",
    "panel": "#faf9f6",
    "surface": "transparent",
    "text": "#2a2a28",
    "textStrong": "#1a1a18",
    "muted": "#888888",
    "border": "#ddd8ce",
    "accent": "#1a1a18",
    "onAccent": "#f6f4f0",
    "ok": "#3a5a40",
    "warn": "#8a6a30",
    "danger": "#a04040"
  },
  "typography": {
    "family": "Cormorant Garamond, Georgia, serif",
    "displaySize": "52px",
    "titleSize": "13px",
    "bodySize": "13px",
    "labelSize": "10px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "0",
    "button": "0",
    "card": "0",
    "badge": "0",
    "input": "0"
  },
  "borders": {
    "width": "0.5px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "0 18px 50px rgba(20,20,15,0.06)",
    "button": "none"
  },
  "spacing": {
    "section": "36px",
    "block": "22px",
    "gap": "18px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "transparent",
        "fg": "{colors.textStrong}",
        "border": "{colors.textStrong}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
