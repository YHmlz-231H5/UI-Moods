{
  "id": "eco",
  "version": "1.0.0",
  "meta": {
    "name": "Eco",
    "nameZh": "环保",
    "appearance": "light",
    "surfaceFamily": "botanical-natural",
    "keywords": [
      "sustainability",
      "organic",
      "green",
      "calm"
    ],
    "fonts": {
      "preferred": [
        "Nunito Sans",
        "Inter"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f3f8f2",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#33413a",
    "textStrong": "#16241c",
    "muted": "#7b8b80",
    "border": "#dce8dc",
    "accent": "#2f7d4f",
    "onAccent": "#ffffff",
    "ok": "#4c9a6a",
    "warn": "#d99a2b",
    "danger": "#c1554a"
  },
  "typography": {
    "family": "Nunito Sans, Inter, system-ui, sans-serif",
    "displaySize": "38px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "10px",
    "button": "999px",
    "card": "16px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(6px)",
    "panelOpacity": 0.95,
    "glow": "none"
  },
  "shadows": {
    "card": "0 8px 24px rgba(47,125,79,0.12)",
    "button": "0 2px 8px rgba(47,125,79,0.14)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "ease-out"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
