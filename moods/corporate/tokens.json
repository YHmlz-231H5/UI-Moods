{
  "id": "corporate",
  "version": "1.0.0",
  "meta": {
    "name": "Corporate",
    "nameZh": "企管",
    "appearance": "light",
    "surfaceFamily": "saas-clean",
    "keywords": [
      "saas",
      "enterprise",
      "data-dense",
      "trustworthy"
    ],
    "fonts": {
      "preferred": [
        "Inter",
        "SF Pro Text"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f4f6fa",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#344054",
    "textStrong": "#101828",
    "muted": "#667085",
    "border": "#e4e7ec",
    "accent": "#175cd3",
    "onAccent": "#ffffff",
    "ok": "#039855",
    "warn": "#dc6803",
    "danger": "#d92d20"
  },
  "typography": {
    "family": "Inter, SF Pro Text, system-ui, sans-serif",
    "displaySize": "32px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "8px",
    "button": "8px",
    "card": "12px",
    "badge": "999px",
    "input": "8px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "0 1px 3px rgba(16,24,40,0.10)",
    "button": "0 1px 2px rgba(16,24,40,0.08)"
  },
  "spacing": {
    "section": "24px",
    "block": "16px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
