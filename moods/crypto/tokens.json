{
  "id": "crypto",
  "version": "1.0.0",
  "meta": {
    "name": "Crypto",
    "nameZh": "加密",
    "appearance": "dark",
    "surfaceFamily": "terminal-lime",
    "keywords": [
      "crypto",
      "terminal",
      "lime",
      "monospace"
    ],
    "fonts": {
      "preferred": [
        "IBM Plex Mono",
        "JetBrains Mono"
      ],
      "fallbacks": [
        "Consolas",
        "monospace"
      ]
    }
  },
  "colors": {
    "bg": "#0b0e11",
    "panel": "#12161c",
    "surface": "#171c24",
    "text": "#aeb8c4",
    "textStrong": "#f0f3f5",
    "muted": "#6b7785",
    "border": "#222833",
    "accent": "#b6f000",
    "onAccent": "#0b0e11",
    "ok": "#26d0a0",
    "warn": "#f0b400",
    "danger": "#f04438"
  },
  "typography": {
    "family": "IBM Plex Mono, JetBrains Mono, Consolas, monospace",
    "displaySize": "36px",
    "titleSize": "15px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "4px",
    "button": "4px",
    "card": "6px",
    "badge": "999px",
    "input": "4px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "0 0 18px rgba(182,240,0,0.35)"
  },
  "shadows": {
    "card": "0 4px 18px rgba(0,0,0,0.5)",
    "button": "none"
  },
  "spacing": {
    "section": "24px",
    "block": "16px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "linear"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
