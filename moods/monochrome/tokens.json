{
  "id": "monochrome",
  "version": "1.0.0",
  "meta": {
    "name": "Monochrome",
    "nameZh": "素白",
    "appearance": "light",
    "surfaceFamily": "flat-greyscale",
    "keywords": [
      "monochrome",
      "greyscale",
      "high-contrast",
      "minimal"
    ],
    "fonts": {
      "preferred": [
        "Inter",
        "Helvetica Neue"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#ffffff",
    "panel": "#fafafa",
    "surface": "#f5f5f5",
    "text": "#262626",
    "textStrong": "#000000",
    "muted": "#8c8c8c",
    "border": "#e4e4e4",
    "accent": "#000000",
    "onAccent": "#ffffff",
    "ok": "#3d3d3d",
    "warn": "#6b6b6b",
    "danger": "#000000"
  },
  "typography": {
    "family": "Inter, Helvetica Neue, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "2px",
    "button": "2px",
    "card": "2px",
    "badge": "999px",
    "input": "2px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "none",
    "button": "none"
  },
  "spacing": {
    "section": "36px",
    "block": "20px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
