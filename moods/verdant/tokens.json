{
  "id": "verdant",
  "version": "1.0.0",
  "meta": {
    "name": "Verdant",
    "nameZh": "磷光",
    "appearance": "dark",
    "surfaceFamily": "phosphor-terminal",
    "keywords": [
      "phosphor",
      "crt",
      "terminal",
      "mono",
      "green"
    ],
    "fonts": {
      "preferred": [
        "Share Tech Mono"
      ],
      "fallbacks": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "colors": {
    "bg": "#050806",
    "panel": "#080c09",
    "surface": "#0b120e",
    "text": "#8fbf9a",
    "textStrong": "#c8f0d0",
    "muted": "#4a7a55",
    "border": "rgba(80,220,120,0.28)",
    "accent": "#39ff8a",
    "onAccent": "#050806",
    "ok": "#39ff8a",
    "warn": "#c8ff5a",
    "danger": "#ff6b6b"
  },
  "typography": {
    "family": "Share Tech Mono, 'JetBrains Mono', ui-monospace, monospace",
    "displaySize": "36px",
    "titleSize": "14px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "0",
    "button": "0",
    "card": "0",
    "badge": "0",
    "input": "0"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "glow": "0 0 12px rgba(57,255,138,0.35)"
  },
  "shadows": {
    "card": "inset 0 0 0 1px rgba(57,255,138,0.04)",
    "button": "none"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}"
    }
  }
}
