{
  "id": "pastel",
  "version": "1.0.0",
  "meta": {
    "name": "Pastel",
    "nameZh": "粉彩",
    "appearance": "light",
    "surfaceFamily": "soft-pastel",
    "keywords": [
      "pastel",
      "soft",
      "low-saturation",
      "friendly"
    ],
    "fonts": {
      "preferred": [
        "Quicksand",
        "Nunito"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#fdf6f8",
    "panel": "#ffffff",
    "surface": "#f7eef5",
    "text": "#4a4458",
    "textStrong": "#2f2b3d",
    "muted": "#918b9e",
    "border": "#e8dfe6",
    "accent": "#b8a1e3",
    "onAccent": "#ffffff",
    "ok": "#a8d5ba",
    "warn": "#f6d6ad",
    "danger": "#f2a1a1"
  },
  "typography": {
    "family": "Quicksand, Nunito, system-ui, sans-serif",
    "displaySize": "40px",
    "titleSize": "17px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "14px",
    "button": "999px",
    "card": "20px",
    "badge": "999px",
    "input": "12px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(8px)",
    "panelOpacity": 0.9,
    "glow": "none"
  },
  "shadows": {
    "card": "0 10px 30px rgba(120,100,140,0.10)",
    "button": "0 4px 12px rgba(120,100,140,0.12)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "ease-out"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
