{
  "id": "glass",
  "version": "1.0.0",
  "meta": {
    "name": "Glass",
    "nameZh": "毛玻璃",
    "appearance": "dark",
    "surfaceFamily": "frosted-glass",
    "keywords": [
      "frosted",
      "backdrop-blur",
      "translucent",
      "glassmorphism"
    ],
    "fonts": {
      "preferred": [
        "Space Grotesk"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#0f1023",
    "panel": "rgba(255,255,255,0.08)",
    "surface": "rgba(255,255,255,0.14)",
    "text": "#d8d8f0",
    "textStrong": "#ffffff",
    "muted": "#9aa0c8",
    "border": "rgba(255,255,255,0.18)",
    "accent": "#8b7bff",
    "onAccent": "#0b0b18",
    "ok": "#4ade80",
    "warn": "#fbbf24",
    "danger": "#fb7185"
  },
  "typography": {
    "family": "Space Grotesk, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "16px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "18px",
    "button": "12px",
    "card": "20px",
    "badge": "999px",
    "input": "12px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(16px)",
    "panelOpacity": 0.08,
    "glow": "0 0 24px rgba(139,123,255,0.25)"
  },
  "shadows": {
    "card": "0 12px 36px rgba(5,5,20,0.4)",
    "button": "inset 0 1px 0 rgba(255,255,255,0.16)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
