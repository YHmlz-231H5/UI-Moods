{
  "id": "ios",
  "version": "1.0.0",
  "meta": {
    "name": "iOS",
    "nameZh": "苹果风",
    "appearance": "light",
    "surfaceFamily": "system-rounded",
    "keywords": [
      "sf-pro",
      "rounded",
      "grouped",
      "system-blue"
    ],
    "fonts": {
      "preferred": [
        "-apple-system"
      ],
      "fallbacks": [
        "BlinkMacSystemFont",
        "'SF Pro Text'",
        "'PingFang SC'",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f2f2f7",
    "panel": "#e9e9ee",
    "surface": "rgba(255,255,255,0.72)",
    "text": "#3c3c43",
    "textStrong": "#1c1c1e",
    "muted": "#8e8e93",
    "border": "rgba(60,60,67,0.12)",
    "accent": "#007aff",
    "onAccent": "#ffffff",
    "ok": "#34c759",
    "warn": "#ff9500",
    "danger": "#ff3b30"
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif",
    "displaySize": "44px",
    "titleSize": "15px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "16px",
    "button": "12px",
    "card": "18px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(18px)"
  },
  "shadows": {
    "card": "0 10px 30px rgba(28,28,30,0.08)",
    "button": "0 1px 2px rgba(28,28,30,0.06)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
