{
  "id": "finance",
  "version": "1.0.0",
  "meta": {
    "name": "Finance",
    "nameZh": "金融",
    "appearance": "dark",
    "surfaceFamily": "noir-gold",
    "keywords": [
      "banking",
      "noir",
      "gold",
      "tabular-numbers"
    ],
    "fonts": {
      "preferred": [
        "IBM Plex Sans",
        "Inter"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#0e1116",
    "panel": "#141920",
    "surface": "#1a2029",
    "text": "#c7d2e4",
    "textStrong": "#ffffff",
    "muted": "#7e8da6",
    "border": "rgba(255,255,255,0.10)",
    "accent": "#d4af37",
    "onAccent": "#0e1116",
    "ok": "#22c55e",
    "warn": "#f59e0b",
    "danger": "#ef4444"
  },
  "typography": {
    "family": "IBM Plex Sans, Inter, system-ui, sans-serif",
    "displaySize": "40px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "6px",
    "button": "6px",
    "card": "10px",
    "badge": "999px",
    "input": "6px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "0 8px 28px rgba(0,0,0,0.45)",
    "button": "0 1px 2px rgba(0,0,0,0.4)"
  },
  "spacing": {
    "section": "24px",
    "block": "16px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
