{
  "id": "travel",
  "version": "1.0.0",
  "meta": {
    "name": "Travel",
    "nameZh": "旅行",
    "appearance": "light",
    "surfaceFamily": "airy-sky",
    "keywords": [
      "travel",
      "booking",
      "airy",
      "sky"
    ],
    "fonts": {
      "preferred": [
        "Montserrat",
        "Inter"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#eef6fb",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#23415c",
    "textStrong": "#102a3f",
    "muted": "#7d9bb3",
    "border": "#d6e7f2",
    "accent": "#0b7fab",
    "onAccent": "#ffffff",
    "ok": "#1fa97a",
    "warn": "#e8a13c",
    "danger": "#d9534f"
  },
  "typography": {
    "family": "Montserrat, Inter, system-ui, sans-serif",
    "displaySize": "40px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "10px",
    "button": "999px",
    "card": "16px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(8px)",
    "panelOpacity": 0.95,
    "glow": "none"
  },
  "shadows": {
    "card": "0 8px 26px rgba(11,127,171,0.14)",
    "button": "0 3px 10px rgba(11,127,171,0.16)"
  },
  "spacing": {
    "section": "30px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.25s",
    "easing": "ease-out"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
