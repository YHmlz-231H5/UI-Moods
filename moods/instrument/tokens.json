{
  "id": "instrument",
  "version": "1.0.0",
  "meta": {
    "name": "Instrument",
    "nameZh": "仪表",
    "appearance": "dark",
    "surfaceFamily": "precision-flat",
    "keywords": [
      "precision",
      "monospace",
      "hairline",
      "readout"
    ],
    "fonts": {
      "preferred": [
        "JetBrains Mono"
      ],
      "fallbacks": [
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "colors": {
    "bg": "#0e1114",
    "panel": "#12161a",
    "surface": "#0f1317",
    "text": "#b8c4ce",
    "textStrong": "#e6eef4",
    "muted": "#6a7a88",
    "border": "#243038",
    "accent": "#7eb8ff",
    "onAccent": "#0a1016",
    "ok": "#6ecf8e",
    "warn": "#e0b060",
    "danger": "#e07080"
  },
  "typography": {
    "family": "JetBrains Mono, ui-monospace, monospace",
    "displaySize": "36px",
    "titleSize": "14px",
    "bodySize": "12px",
    "labelSize": "10px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "2px",
    "button": "0",
    "card": "2px",
    "badge": "0",
    "input": "0"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "none",
    "button": "none"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}"
    }
  }
}
