{
  "id": "anime",
  "version": "1.0.0",
  "meta": {
    "name": "Anime",
    "nameZh": "动漫",
    "appearance": "light",
    "surfaceFamily": "kawaii-sticker",
    "keywords": [
      "kawaii",
      "sticker",
      "halftone",
      "sparkle"
    ],
    "fonts": {
      "preferred": [
        "M PLUS Rounded 1c"
      ],
      "fallbacks": [
        "'PingFang SC'",
        "'Microsoft YaHei'",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#fff4f8",
    "panel": "#ffe9f2",
    "surface": "#ffffff",
    "text": "#5d4254",
    "textStrong": "#382036",
    "muted": "#b290a4",
    "border": "#ffc9de",
    "accent": "#ff3d9a",
    "onAccent": "#ffffff",
    "ok": "#2fb96e",
    "warn": "#ffb020",
    "danger": "#ff5c6a"
  },
  "typography": {
    "family": "'M PLUS Rounded 1c', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "displaySize": "46px",
    "titleSize": "16px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 700
    }
  },
  "radii": {
    "block": "18px",
    "button": "999px",
    "card": "18px",
    "badge": "999px",
    "input": "12px"
  },
  "borders": {
    "width": "2.5px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "5px 6px 0 #f36ba8",
    "button": "3px 3px 0 #f36ba8"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.15s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
