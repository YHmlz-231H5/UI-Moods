{
  "id": "archive",
  "version": "1.0.0",
  "meta": {
    "name": "Archive",
    "nameZh": "档案",
    "appearance": "light",
    "surfaceFamily": "paper-ink",
    "keywords": [
      "archive",
      "paper",
      "serif",
      "stamp",
      "ink"
    ],
    "fonts": {
      "preferred": [
        "Newsreader"
      ],
      "fallbacks": [
        "Georgia",
        "serif"
      ]
    }
  },
  "colors": {
    "bg": "#e8e0d4",
    "panel": "#f4eee4",
    "surface": "#fffaf3",
    "text": "#3a3228",
    "textStrong": "#2c241c",
    "muted": "#7a6a58",
    "border": "#d8cbb6",
    "accent": "#305070",
    "onAccent": "#f4eee4",
    "ok": "#4a6a38",
    "warn": "#9a6a30",
    "danger": "#8a4038",
    "dangerSoft": "#f0e0dc",
    "dangerBorder": "#d0a8a0"
  },
  "typography": {
    "family": "Newsreader, Georgia, serif",
    "displaySize": "42px",
    "titleSize": "17px",
    "bodySize": "14px",
    "labelSize": "10px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "3px",
    "button": "2px",
    "card": "3px",
    "badge": "2px",
    "input": "2px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "0 1px 0 #efe6d8, 0 8px 20px rgba(80,60,30,0.05)",
    "button": "none"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.textStrong}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.dangerSoft}",
        "fg": "{colors.danger}",
        "border": "{colors.dangerBorder}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
