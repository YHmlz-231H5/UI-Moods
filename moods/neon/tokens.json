{
  "id": "neon",
  "version": "1.0.0",
  "meta": {
    "name": "Neon",
    "nameZh": "霓虹",
    "appearance": "dark",
    "surfaceFamily": "neon-glow",
    "keywords": [
      "neon",
      "cyberpunk",
      "glow",
      "magenta-cyan"
    ],
    "fonts": {
      "preferred": [
        "Orbitron",
        "Eurostile"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#0a0a12",
    "panel": "rgba(255,255,255,0.04)",
    "surface": "rgba(255,255,255,0.07)",
    "text": "#e8e8f0",
    "textStrong": "#ffffff",
    "muted": "#8b8ba7",
    "border": "rgba(255,255,255,0.16)",
    "accent": "#ff2d95",
    "onAccent": "#0a0a12",
    "ok": "#00f5d4",
    "warn": "#ffb800",
    "danger": "#ff0066"
  },
  "typography": {
    "family": "Orbitron, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "8px",
    "button": "6px",
    "card": "12px",
    "badge": "999px",
    "input": "6px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(12px)",
    "panelOpacity": 0.04,
    "glow": "0 0 24px rgba(255,45,149,0.5)"
  },
  "shadows": {
    "card": "0 12px 40px rgba(0,0,0,0.6)",
    "button": "0 0 16px rgba(255,45,149,0.4)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.25s",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
