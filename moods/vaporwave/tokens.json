{
  "id": "vaporwave",
  "version": "1.0.0",
  "meta": {
    "name": "Vaporwave",
    "nameZh": "蒸汽波",
    "appearance": "dark",
    "surfaceFamily": "synthwave-retro",
    "keywords": [
      "vaporwave",
      "synthwave",
      "magenta-cyan",
      "retro-future"
    ],
    "fonts": {
      "preferred": [
        "VT323",
        "Courier New"
      ],
      "fallbacks": [
        "monospace"
      ]
    }
  },
  "colors": {
    "bg": "#2b1b47",
    "panel": "rgba(255,255,255,0.06)",
    "surface": "rgba(255,120,220,0.10)",
    "text": "#d9d0ff",
    "textStrong": "#ffffff",
    "muted": "#9a8fc4",
    "border": "rgba(255,255,255,0.18)",
    "accent": "#ff71ce",
    "onAccent": "#2b1b47",
    "ok": "#05d9e8",
    "warn": "#fff95a",
    "danger": "#ff2e63"
  },
  "typography": {
    "family": "VT323, Courier New, monospace",
    "displaySize": "46px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "8px",
    "button": "6px",
    "card": "12px",
    "badge": "999px",
    "input": "6px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(10px)",
    "panelOpacity": 0.06,
    "glow": "0 0 26px rgba(255,113,206,0.55)"
  },
  "shadows": {
    "card": "0 10px 36px rgba(20,5,50,0.6)",
    "button": "0 0 18px rgba(255,113,206,0.4)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
