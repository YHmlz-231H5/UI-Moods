{
  "id": "forest",
  "version": "1.0.0",
  "meta": {
    "name": "Forest",
    "nameZh": "森系",
    "appearance": "light",
    "surfaceFamily": "botanical",
    "keywords": [
      "moss",
      "wood",
      "botanical",
      "organic"
    ],
    "fonts": {
      "preferred": [
        "Klee One"
      ],
      "fallbacks": [
        "'PingFang SC'",
        "'Microsoft YaHei'",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#eef2e5",
    "panel": "#e3ead7",
    "surface": "#fbfdf5",
    "text": "#46523f",
    "textStrong": "#26301f",
    "muted": "#7d8a72",
    "border": "#cdd9ba",
    "accent": "#3f6b34",
    "onAccent": "#f5f8ee",
    "ok": "#5f8f4e",
    "warn": "#c2913f",
    "danger": "#b05f47"
  },
  "typography": {
    "family": "'Klee One', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "displaySize": "42px",
    "titleSize": "16px",
    "bodySize": "13px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "16px",
    "button": "999px",
    "card": "18px",
    "badge": "999px",
    "input": "12px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "0 8px 22px rgba(60,80,45,0.09)",
    "button": "0 2px 0 rgba(100,120,80,0.18)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
