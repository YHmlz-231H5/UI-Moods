{
  "id": "bauhaus",
  "version": "1.0.0",
  "meta": {
    "name": "Bauhaus",
    "nameZh": "包豪斯",
    "appearance": "light",
    "surfaceFamily": "geometric-primary",
    "keywords": [
      "bauhaus",
      "primary-colors",
      "geometric",
      "constructivist"
    ],
    "fonts": {
      "preferred": [
        "Futura",
        "Century Gothic"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f2ede4",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#1c1c1c",
    "textStrong": "#000000",
    "muted": "#6b6b6b",
    "border": "#1c1c1c",
    "accent": "#d7263d",
    "onAccent": "#ffffff",
    "ok": "#1b998b",
    "warn": "#f6ae2d",
    "danger": "#22223b"
  },
  "typography": {
    "family": "Futura, Century Gothic, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "17px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "0px",
    "button": "0px",
    "card": "0px",
    "badge": "0px",
    "input": "0px"
  },
  "borders": {
    "width": "3px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "4px 4px 0 0 #1c1c1c",
    "button": "3px 3px 0 0 #1c1c1c"
  },
  "spacing": {
    "section": "30px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
