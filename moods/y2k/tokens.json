{
  "id": "y2k",
  "version": "1.0.0",
  "meta": {
    "name": "Y2K",
    "nameZh": "千禧",
    "appearance": "light",
    "surfaceFamily": "chrome-gradient",
    "keywords": [
      "y2k",
      "chrome",
      "bubble",
      "gradient"
    ],
    "fonts": {
      "preferred": [
        "Verdana",
        "Trebuchet MS"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#e9f2ff",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#1a1a2e",
    "textStrong": "#0b0b18",
    "muted": "#6a6a8a",
    "border": "#b8c6ff",
    "accent": "#7b2ff7",
    "onAccent": "#ffffff",
    "ok": "#00c853",
    "warn": "#ffd166",
    "danger": "#ff4d6d"
  },
  "typography": {
    "family": "Verdana, Trebuchet MS, system-ui, sans-serif",
    "displaySize": "44px",
    "titleSize": "17px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "16px",
    "button": "999px",
    "card": "24px",
    "badge": "999px",
    "input": "999px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "blur(10px)",
    "panelOpacity": 0.9,
    "glow": "0 0 24px rgba(123,47,247,0.28)"
  },
  "shadows": {
    "card": "0 8px 24px rgba(123,47,247,0.18)",
    "button": "0 4px 12px rgba(123,47,247,0.22)"
  },
  "spacing": {
    "section": "30px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.3s",
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}",
      "backdropFilter": "{effects.backdropFilter}"
    }
  }
}
