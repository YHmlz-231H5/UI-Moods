{
  "id": "brutal",
  "version": "1.0.0",
  "meta": {
    "name": "Brutal",
    "nameZh": "粗野派",
    "appearance": "light",
    "surfaceFamily": "brutal-hard",
    "keywords": [
      "brutalist",
      "hard-shadow",
      "zero-radius",
      "high-contrast"
    ],
    "fonts": {
      "preferred": [
        "Archivo Black",
        "Arial Black"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f2f2f2",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#111111",
    "textStrong": "#000000",
    "muted": "#5f5f5f",
    "border": "#000000",
    "accent": "#ffd400",
    "onAccent": "#000000",
    "ok": "#00c853",
    "warn": "#ff9100",
    "danger": "#ff1744"
  },
  "typography": {
    "family": "Archivo Black, Arial Black, system-ui, sans-serif",
    "displaySize": "48px",
    "titleSize": "18px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "0px",
    "button": "0px",
    "card": "0px",
    "badge": "0px",
    "input": "0px"
  },
  "borders": {
    "width": "2px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "6px 6px 0 0 #000000",
    "button": "4px 4px 0 0 #000000"
  },
  "spacing": {
    "section": "32px",
    "block": "20px",
    "gap": "14px"
  },
  "motion": {
    "duration": "0.1s",
    "easing": "steps(2, end)"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
