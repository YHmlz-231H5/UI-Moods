{
  "id": "medical",
  "version": "1.0.0",
  "meta": {
    "name": "Medical",
    "nameZh": "医疗",
    "appearance": "light",
    "surfaceFamily": "clinical-calm",
    "keywords": [
      "healthcare",
      "clinical",
      "calm",
      "teal"
    ],
    "fonts": {
      "preferred": [
        "Source Sans 3",
        "Inter"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f0f7f8",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#2c4a4e",
    "textStrong": "#14343a",
    "muted": "#6d8b90",
    "border": "#d3e5e7",
    "accent": "#0e7c86",
    "onAccent": "#ffffff",
    "ok": "#2f9e44",
    "warn": "#f08c00",
    "danger": "#e03131"
  },
  "typography": {
    "family": "Source Sans 3, Inter, system-ui, sans-serif",
    "displaySize": "34px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "8px",
    "button": "8px",
    "card": "14px",
    "badge": "999px",
    "input": "8px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "0 4px 16px rgba(20,52,58,0.08)",
    "button": "0 1px 3px rgba(20,52,58,0.10)"
  },
  "spacing": {
    "section": "24px",
    "block": "16px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
