{
  "id": "swiss",
  "version": "1.0.0",
  "meta": {
    "name": "Swiss",
    "nameZh": "瑞士",
    "appearance": "light",
    "surfaceFamily": "editorial-grid",
    "keywords": [
      "swiss",
      "helvetica",
      "grid",
      "red-accent"
    ],
    "fonts": {
      "preferred": [
        "Helvetica Neue",
        "Inter"
      ],
      "fallbacks": [
        "Arial",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#ffffff",
    "panel": "#ffffff",
    "surface": "#f4f4f4",
    "text": "#111111",
    "textStrong": "#000000",
    "muted": "#767676",
    "border": "#d9d9d9",
    "accent": "#e30613",
    "onAccent": "#ffffff",
    "ok": "#0a7d33",
    "warn": "#ffb400",
    "danger": "#a30014"
  },
  "typography": {
    "family": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "displaySize": "56px",
    "titleSize": "18px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 700
    }
  },
  "radii": {
    "block": "0px",
    "button": "0px",
    "card": "0px",
    "badge": "0px",
    "input": "0px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "none",
    "button": "none"
  },
  "spacing": {
    "section": "48px",
    "block": "24px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
