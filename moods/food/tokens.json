{
  "id": "food",
  "version": "1.0.0",
  "meta": {
    "name": "Food",
    "nameZh": "美食",
    "appearance": "light",
    "surfaceFamily": "warm-appetizing",
    "keywords": [
      "food",
      "appetizing",
      "warm",
      "menu"
    ],
    "fonts": {
      "preferred": [
        "Poppins",
        "Nunito"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#fff8f2",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#4a3527",
    "textStrong": "#2c1d13",
    "muted": "#90796a",
    "border": "#f0dfcd",
    "accent": "#e8590c",
    "onAccent": "#ffffff",
    "ok": "#2f9e44",
    "warn": "#f08c00",
    "danger": "#e03131",
    "onAccentSolid": "#2a1c12",
    "onOkSolid": "#2c1d13",
    "onWarnSolid": "#2c1d13",
    "onDangerSolid": "#000000"
  },
  "typography": {
    "family": "Poppins, Nunito, system-ui, sans-serif",
    "displaySize": "40px",
    "titleSize": "17px",
    "bodySize": "14px",
    "labelSize": "12px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "10px",
    "button": "999px",
    "card": "16px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1,
    "glow": "none"
  },
  "shadows": {
    "card": "0 10px 30px rgba(232,89,12,0.14)",
    "button": "0 4px 12px rgba(232,89,12,0.18)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.25s",
    "easing": "ease-out"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      },
      "danger": {
        "bg": "transparent",
        "fg": "{colors.danger}",
        "border": "{colors.danger}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    },
    "badge": {
      "neutral": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.border}",
        "radius": "{radii.badge}"
      },
      "accent": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccentSolid}",
        "border": "{colors.accent}",
        "radius": "{radii.badge}"
      },
      "ok": {
        "bg": "{colors.ok}",
        "fg": "{colors.onOkSolid}",
        "border": "{colors.ok}",
        "radius": "{radii.badge}"
      },
      "warn": {
        "bg": "{colors.warn}",
        "fg": "{colors.onWarnSolid}",
        "border": "{colors.warn}",
        "radius": "{radii.badge}"
      },
      "danger": {
        "bg": "{colors.danger}",
        "fg": "{colors.onDangerSolid}",
        "border": "{colors.danger}",
        "radius": "{radii.badge}"
      }
    },
    "alert": {
      "neutral": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.border}"
      },
      "accent": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.accent}"
      },
      "ok": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.ok}"
      },
      "warn": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.warn}"
      },
      "danger": {
        "bg": "{colors.panel}",
        "fg": "{colors.text}",
        "border": "{colors.danger}"
      }
    }
  }
}
