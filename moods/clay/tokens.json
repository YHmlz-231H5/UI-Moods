{
  "id": "clay",
  "version": "1.0.0",
  "meta": {
    "name": "Clay",
    "nameZh": "陶土",
    "appearance": "light",
    "surfaceFamily": "matte-clay",
    "keywords": [
      "clay",
      "matte",
      "ceramic",
      "organic",
      "soft"
    ],
    "fonts": {
      "preferred": [
        "DM Sans"
      ],
      "fallbacks": [
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#d9cfc4",
    "panel": "#e6ddd2",
    "surface": "#efe7dc",
    "text": "#4a4038",
    "textStrong": "#2c2620",
    "muted": "#8a7c6e",
    "border": "transparent",
    "accent": "#6b4f3a",
    "onAccent": "#f6efe6",
    "ok": "#5a6e4a",
    "warn": "#9a6a30",
    "danger": "#8a4840"
  },
  "typography": {
    "family": "DM Sans, system-ui, sans-serif",
    "displaySize": "42px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "18px",
    "button": "999px",
    "card": "18px",
    "badge": "999px",
    "input": "12px"
  },
  "borders": {
    "width": "0",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none"
  },
  "shadows": {
    "card": "0 10px 28px rgba(70,50,30,0.1), 0 1px 0 rgba(255,255,255,0.35) inset",
    "button": "inset 0 -2px 0 rgba(80,60,40,0.08), 0 1px 0 rgba(255,255,255,0.4)"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "16px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    },
    "card": {
      "bg": "{colors.surface}",
      "radius": "{radii.card}",
      "shadow": "{shadows.card}"
    }
  }
}
