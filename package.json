{
  "name": "ui-moods",
  "version": "1.1.0",
  "description": "A standardised UI component library with 32 switchable style skins — plus the style specimen registry and app reference library it grew out of.",
  "type": "module",
  "bin": {
    "ui-moods": "./tools/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./tools/cli.mjs"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "default": "./vue/index.js"
    },
    "./vue/*": {
      "default": "./vue/components/*.js"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.d.ts"
    },
    "./css/all.css": "./css/all.css",
    "./css/base.css": "./css/base.css",
    "./css/*.css": "./css/*.css",
    "./components/um-components.css": "./components/um-components.css",
    "./themes/all.css": "./themes/all.css",
    "./themes/*.css": "./themes/*.css",
    "./themes/switcher": {
      "types": "./themes/switcher.d.ts",
      "default": "./themes/switcher.js"
    },
    "./themes/switcher.js": "./themes/switcher.js",
    "./themes/index.json": "./themes/index.json",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "components/",
    "css/",
    "themes/",
    "vue/",
    "types/",
    "tokens/",
    "schemas/",
    "tools/",
    "templates/",
    "docs/",
    "examples/",
    "moods/*/tokens.json",
    "moods/*/checklist.yaml",
    "moods/*/prompt.md",
    "apps/*/app.json",
    "moods.json",
    "apps.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YHmlz-231H5/UI-Moods.git"
  },
  "bugs": {
    "url": "https://github.com/YHmlz-231H5/UI-Moods/issues"
  },
  "homepage": "https://github.com/YHmlz-231H5/UI-Moods#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  },
  "scripts": {
    "build-specimen": "node tools/build-specimen.mjs",
    "build-apps": "node tools/build-apps.mjs --all",
    "build-components": "node tools/build-components.mjs",
    "build-themes": "node tools/build-themes.mjs",
    "build-docs": "node tools/build-docs.mjs",
    "build-types": "node tools/build-types.mjs",
    "build-vue": "node tools/build-vue.mjs",
    "build-dist": "node tools/build-dist.mjs",
    "build:package": "npm run build-components && npm run build-docs && npm run build-types && npm run build-vue && npm run build-dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:wrappers": "tsc -p tsconfig.wrappers.json --noEmit",
    "check-vue": "node tools/check-vue.mjs",
    "check-component": "node tools/check-component.mjs",
    "check-package": "node tools/check-package.mjs",
    "audit-contrast": "node tools/audit-contrast.mjs",
    "audit-render": "node tools/audit-render.mjs",
    "audit-render:apps": "node tools/audit-render.mjs apps",
    "verify-themes": "node tools/verify-themes.mjs",
    "validate": "node tools/validate.mjs",
    "bundle": "node tools/bundle.mjs",
    "serve": "node tools/serve.mjs",
    "scaffold": "node tools/scaffold.mjs",
    "prepublishOnly": "npm run build:package",
    "build:all": "node tools/build-specimen.mjs anime archive aurora bauhaus blueprint brutal clay corporate crypto eco fashion finance food forest gaming glass instrument ios luxury medical monochrome neon night nordic pastel retro sakura swiss travel vaporwave verdant y2k && node tools/build-apps.mjs --all"
  },
  "keywords": [
    "ui",
    "design-tokens",
    "design-system",
    "component-library",
    "element-plus",
    "vue",
    "theme",
    "skin",
    "style-guide",
    "ai-agents"
  ],
  "devDependencies": {
    "@vue/server-renderer": "^3.5.46",
    "typescript": "^5.6.3",
    "vue": "^3.5.46"
  }
}
