{
  "id": "your-mood",
  "version": "1.0.0",
  "meta": {
    "name": "Your Mood",
    "nameZh": "你的主题",
    "appearance": "light",
    "surfaceFamily": "flat",
    "keywords": [
      "replace-me"
    ],
    "fonts": {
      "preferred": [
        "system-ui"
      ],
      "fallbacks": [
        "sans-serif"
      ]
    }
  },
  "colors": {
    "bg": "#f5f5f5",
    "panel": "#ffffff",
    "surface": "#ffffff",
    "text": "#333333",
    "textStrong": "#111111",
    "muted": "#888888",
    "border": "#dddddd",
    "accent": "#2e7d5b",
    "onAccent": "#ffffff",
    "ok": "#2fb96e",
    "warn": "#c2913f",
    "danger": "#b05f47"
  },
  "typography": {
    "family": "system-ui, sans-serif",
    "displaySize": "40px",
    "titleSize": "16px",
    "bodySize": "14px",
    "labelSize": "11px",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "radii": {
    "block": "14px",
    "button": "10px",
    "card": "16px",
    "badge": "999px",
    "input": "10px"
  },
  "borders": {
    "width": "1px",
    "style": "solid"
  },
  "effects": {
    "backdropFilter": "none",
    "panelOpacity": 1
  },
  "shadows": {
    "card": "0 4px 16px rgba(0,0,0,0.08)",
    "button": "none"
  },
  "spacing": {
    "section": "28px",
    "block": "18px",
    "gap": "12px"
  },
  "motion": {
    "duration": "0.2s",
    "easing": "ease"
  },
  "components": {
    "button": {
      "primary": {
        "bg": "{colors.accent}",
        "fg": "{colors.onAccent}",
        "radius": "{radii.button}"
      }
    }
  }
}
